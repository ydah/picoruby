module Net
  class HTTP
    MAX_TRANSPORT_INTEGER: Integer

    attr_accessor address: String
    attr_accessor port: Integer
    attr_accessor open_timeout: Integer | Float
    attr_accessor read_timeout: Integer | Float
    attr_accessor write_timeout: (Integer | Float)?
    attr_accessor total_timeout: (Integer | Float)?
    attr_accessor max_request_bytes: Integer?
    attr_accessor max_response_header_bytes: Integer?
    attr_accessor max_response_body_bytes: Integer?
    attr_accessor max_response_line_bytes: Integer?
    attr_accessor use_ssl: bool
    attr_accessor verify_mode: Integer?
    attr_accessor ca_file: String?
    attr_accessor ca_path: String?
    attr_reader started: bool

    def initialize: (String address, ?Integer? port) -> void
    def start: () { (HTTP) -> untyped } -> HTTP
             | () -> HTTP
    def finish: () -> void
    def active?: () -> bool
    def get: (String path, ?Hash[String, String]? initheader, ?untyped dest) ?{ (String) -> void } -> HTTPResponse
    def head: (String path, ?Hash[String, String]? initheader) -> HTTPResponse
    def post: (String path, String data, ?Hash[String, String]? initheader, ?untyped dest) { (String) -> void } -> HTTPResponse
    def put: (String path, String data, ?Hash[String, String]? initheader, ?untyped dest) { (String) -> void } -> HTTPResponse
    def delete: (String path, ?Hash[String, String]? initheader, ?untyped dest) { (String) -> void } -> HTTPResponse
    def request: (HTTPGenericRequest req, ?String? body) ?{ (String) -> void } -> HTTPResponse
    def self.get: (String uri_or_host, String path, ?Integer? port) -> String?
    alias self._get self.get
    def self.get_response: (String uri_or_host, ?String? path, ?Integer? port) -> HTTPResponse
    def self.post_form: (String url, Hash[untyped, untyped] params) -> HTTPResponse
    def use_ssl?: () -> bool
    private def new_transport_context: () -> HTTPTransportContext
    private def connect: (HTTPTransportContext context) -> void
    private def validate_timeout: (untyped value) -> untyped
    private def validate_size: (untyped value) -> Integer?
    private def bounded_transport?: () -> boolish
    private def transport_deadlines?: () -> bool
    private def serialize_request: (Array[String | Integer] snapshot) -> String

  end

  class HTTPTransportContext
    attr_reader max_response_header_bytes: Integer?
    attr_reader max_response_body_bytes: Integer?
    attr_reader max_response_line_bytes: Integer?
    def initialize: (untyped clock, Integer | Float open_timeout, Integer | Float read_timeout, (Integer | Float)? write_timeout, (Integer | Float)? total_timeout, Integer? header_limit, Integer? body_limit, Integer? line_limit) -> void
    def open_deadline: () -> untyped
    def check!: (?Symbol phase) -> true
    def write: (untyped socket, String wire) -> void
    def read: (untyped socket, Integer maxlen) -> String?
    def probe: (untyped socket) -> untyped
    private def deadline_for: (Integer? stage_deadline, Symbol phase, Symbol timeout_reason) -> Integer?
    private def translate_socket_error: (untyped error, Symbol failed_reason, Symbol timeout_reason) -> bot
    private def to_us: (Integer | Float seconds) -> Integer
    private def add_deadline: (Integer now, Integer delta) -> Integer
  end
end
