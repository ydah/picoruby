module Net
  class HTTPGenericRequest
    attr_reader method: String
    attr_reader path: String
    attr_accessor body: String?

    @header: Hash[String, String]

    def initialize: (String method, String path, ?Hash[String, String]? initheader) -> void
    def []: (String key) -> String?
    def []=: (String key, String value) -> String
    def delete: (String key) -> String?
    def each_header: () { (String, String) -> void } -> void
    def set_default_headers: (String host, Integer port) -> void
    def to_s: () -> String
    def transport_snapshot: (Integer? limit) -> Array[String | Integer]
    def self.serialize_snapshot: (Array[String | Integer] parts) -> String
    def self.format_header_name: (String key) -> String
    def response_body_permitted?: () -> bool
    def request_body_permitted?: () -> bool
    private def checked_string: (untyped value, Symbol part) -> String
    private def checked_add: (Integer total, Integer amount, Integer? limit) -> Integer
    private def token_byte?: (Integer byte) -> bool
    private def validate_token: (String value) -> String
    private def validate_target: (String target) -> void
    private def validate_header_value: (String value) -> void
  end

  class HTTPRequest < HTTPGenericRequest
    def initialize: (String path, ?Hash[String, String]? initheader) -> void
  end

  class Get < HTTPRequest
    def initialize: (String path, ?Hash[String, String]? initheader) -> void
  end

  class Head < HTTPGenericRequest
    def initialize: (String path, ?Hash[String, String]? initheader) -> void
  end

  class Post < HTTPGenericRequest
    def initialize: (String path, ?Hash[String, String]? initheader) -> void
  end

  class Put < HTTPGenericRequest
    def initialize: (String path, ?Hash[String, String]? initheader) -> void
  end

  class Delete < HTTPGenericRequest
    def initialize: (String path, ?Hash[String, String]? initheader) -> void
  end

  class Patch < HTTPGenericRequest
    def initialize: (String path, ?Hash[String, String]? initheader) -> void
  end

  class Options < HTTPGenericRequest
    def initialize: (String path, ?Hash[String, String]? initheader) -> void
  end
end
