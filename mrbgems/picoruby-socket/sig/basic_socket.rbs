class SocketError < StandardError
end

class SocketTransportError < SocketError
  attr_reader reason: Symbol
  def initialize: (Symbol reason) -> void
end

class BasicSocket
  CONNECTION_TIMEOUT_MS: Integer
  READ_TIMEOUT_MS: Integer

  def self.__remaining_timeout_ms: (Integer? deadline, Symbol reason) -> Integer?
  def __transport_read: (Integer maxlen, Integer deadline) -> untyped
  def __transport_write: (String buffer, Integer offset, Integer length, Integer deadline) -> untyped
  def __transport_eof_probe: (Integer deadline) -> untyped
  private def __transport_read_poll: (Integer maxlen, Integer deadline) -> String?
  private def __transport_write_poll: (String buffer, Integer offset, Integer length, Integer deadline) -> Integer?
  private def __transport_eof_probe_poll: (Integer deadline) -> Integer
  def puts: (*untyped args) -> nil
  def gets: (?String sep) -> String?
  def print: (*untyped args) -> nil
  def eof?: () -> bool
  def peeraddr: () -> Array[String | Integer]
  def remote_address: () -> String
  def local_address: () -> nil
  def write: (*String str) -> Integer
  def send: (String data, Integer flags) -> Integer
  def read: (?Integer maxlen) -> (String | nil)
  def readpartial: (Integer maxlen) -> String
  def read_nonblock: (Integer maxlen) -> String?
  def closed?: () -> bool
  def ready?: () -> bool
  def close: () -> void
  def remote_host: () -> String
  def remote_port: () -> Integer
  private def __connection_timeout_ms: () -> Integer
  private def __wait_for_event: (untyped event_queue, String timeout_message) -> void
  private def __readpartial_poll: (Integer maxlen) -> String
  private def __readpartial_event_queue: (Integer maxlen, String timeout_message) -> String
end
