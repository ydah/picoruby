+static void
+dns_cancel_callback(const char *name, const ip_addr_t *ipaddr, void *arg)
+{
+  LWIP_UNUSED_ARG(name);
+  LWIP_UNUSED_ARG(ipaddr);
+  (*(int *)arg)++;
+}
