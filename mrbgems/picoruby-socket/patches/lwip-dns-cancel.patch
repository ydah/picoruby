+/**
+ * @ingroup dns
+ * Cancel a pending DNS request identified by its callback and argument.
+ *
+ * The callback will not be invoked after this function returns. If this is the
+ * last request using a query, the query and its UDP PCB are released as well.
+ * Must be called from the lwIP core context.
+ *
+ * @return 1 if a pending request was cancelled, 0 if no request matched.
+ */
+u8_t
+dns_cancel(dns_found_callback found, void *callback_arg)
+{
+  u8_t i;
+
+  if (found == NULL) {
+    return 0;
+  }
+
+  for (i = 0; i < DNS_MAX_REQUESTS; i++) {
+    if ((dns_requests[i].found == found) &&
+        (dns_requests[i].arg == callback_arg)) {
+      u8_t table_idx;
+      u8_t request_pending = 0;
+#if ((LWIP_DNS_SECURE & LWIP_DNS_SECURE_RAND_SRC_PORT) != 0)
+      u8_t pcb_in_use = 0;
+#endif
+
+#if ((LWIP_DNS_SECURE & LWIP_DNS_SECURE_NO_MULTIPLE_OUTSTANDING) != 0)
+      table_idx = dns_requests[i].dns_table_idx;
+#else
+      table_idx = i;
+#endif
+      dns_requests[i].found = NULL;
+      dns_requests[i].arg = NULL;
+
+#if ((LWIP_DNS_SECURE & LWIP_DNS_SECURE_NO_MULTIPLE_OUTSTANDING) != 0)
+      {
+        u8_t r;
+        for (r = 0; r < DNS_MAX_REQUESTS; r++) {
+          if (dns_requests[r].found &&
+              (dns_requests[r].dns_table_idx == table_idx)) {
+            request_pending = 1;
+            break;
+          }
+        }
+      }
+#endif
+
+      if (!request_pending && (table_idx < DNS_TABLE_SIZE) &&
+          ((dns_table[table_idx].state == DNS_STATE_NEW) ||
+           (dns_table[table_idx].state == DNS_STATE_ASKING))) {
+#if ((LWIP_DNS_SECURE & LWIP_DNS_SECURE_RAND_SRC_PORT) != 0)
+        u8_t table;
+        for (table = 0; table < DNS_TABLE_SIZE; table++) {
+          if ((table != table_idx) &&
+              ((dns_table[table].state == DNS_STATE_NEW) ||
+               (dns_table[table].state == DNS_STATE_ASKING)) &&
+              (dns_table[table].pcb_idx == dns_table[table_idx].pcb_idx)) {
+            pcb_in_use = 1;
+            break;
+          }
+        }
+        if (!pcb_in_use &&
+            (dns_table[table_idx].pcb_idx < DNS_MAX_SOURCE_PORTS)) {
+          udp_remove(dns_pcbs[dns_table[table_idx].pcb_idx]);
+          dns_pcbs[dns_table[table_idx].pcb_idx] = NULL;
+        }
+        dns_table[table_idx].pcb_idx = DNS_MAX_SOURCE_PORTS;
+#endif
+        dns_table[table_idx].state = DNS_STATE_UNUSED;
+      }
+      return 1;
+    }
+  }
+  return 0;
+}
