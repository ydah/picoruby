 /* Test functions */
 
 START_TEST(test_dns_set_get_server)
@@ -41,12 +49,40 @@ START_TEST(test_dns_set_get_server)
 }
 END_TEST
 
+START_TEST(test_dns_cancel_releases_request)
+{
+  int callback_count[2] = { 0, 0 };
+  int i;
+  ip_addr_t addr;
+  ip_addr_t server;
+
+  LWIP_UNUSED_ARG(_i);
+  IP_ADDR4(&server, 192, 0, 2, 1);
+  dns_setserver(0, &server);
+
+  for (i = 0; i < (DNS_TABLE_SIZE * 2); i++) {
+    fail_unless(dns_gethostbyname("pending.example", &addr,
+                                 dns_cancel_callback,
+                                 &callback_count[0]) == ERR_INPROGRESS);
+    fail_unless(dns_gethostbyname("pending.example", &addr,
+                                 dns_cancel_callback,
+                                 &callback_count[1]) == ERR_INPROGRESS);
+    fail_unless(dns_cancel(dns_cancel_callback, &callback_count[0]) == 1);
+    fail_unless(dns_cancel(dns_cancel_callback, &callback_count[0]) == 0);
+    fail_unless(dns_cancel(dns_cancel_callback, &callback_count[1]) == 1);
+  }
+  fail_unless(callback_count[0] == 0);
+  fail_unless(callback_count[1] == 0);
+}
+END_TEST
+
 /** Create the suite including all tests for this module */
 Suite *
 dns_suite(void)
 {
   testfunc tests[] = {
-    TESTFUNC(test_dns_set_get_server)
+    TESTFUNC(test_dns_set_get_server),
+    TESTFUNC(test_dns_cancel_releases_request)
   };
   return create_suite("DNS", tests, sizeof(tests)/sizeof(testfunc), dns_setup, dns_teardown);
 }
